{
  "expo": {
    "name": "Scan&Sign",
    "slug": "scansign",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "scansign",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.scansign.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan&Sign utilise l'appareil photo pour capturer votre signature et votre tampon.",
        "NSPhotoLibraryAddUsageDescription": "Scan&Sign peut enregistrer les documents signés."
      }
    },
    "android": {
      "package": "com.scansign.app",
      "adaptiveIcon": { "backgroundColor": "#2f5fe0" },
      "permissions": ["CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan&Sign utilise l'appareil photo pour capturer votre signature et votre tampon."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2f5fe0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
