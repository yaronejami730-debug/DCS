# ---------------------------------------------------------------------------
# Scan&Sign — copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co  (local: http://127.0.0.1:54321)
SUPABASE_URL=http://127.0.0.1:54321
# Public anon key. Safe to ship to the console. NOT used by the signing app.
SUPABASE_ANON_KEY=replace-me
# Service role key. BACKEND ONLY. Never put this in apps/admin or apps/signer.
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Storage bucket that holds originals/, processed/, signatures/, stamps/, photos/
SUPABASE_STORAGE_BUCKET=scansign

# --- Backend API ----------------------------------------------------------
API_PORT=8787
API_HOST=0.0.0.0
# Public base URL of this API, used in push notification deep links.
API_PUBLIC_URL=http://localhost:8787
# Where the signing app is served. Every share link the console shows is built
# from this, so a wrong value produces links that look right and go nowhere.
# In production: the public HTTPS origin of apps/signer.
SIGNER_PUBLIC_URL=http://localhost:5174
# Comma-separated allowed browser origins for the admin console. Include the
# LAN address too if you open the console from another machine or a phone.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Account creation. The SAME account is used on the web console and on the
# iPhone app — signing in on both is what links a phone to a workspace.
# AUTO_CONFIRM_SIGNUP creates accounts already confirmed (no email round-trip).
AUTO_CONFIRM_SIGNUP=true
# Flip to false once your accounts exist, to close public account creation.
ALLOW_SELF_SIGNUP=true

# --- Signature extraction microservice (fchaussin/signature-remove-bg) -----
# Use 127.0.0.1 rather than localhost: on macOS "localhost" resolves to ::1
# first, and the engine binds IPv4 only, which looks like an outage.
SIGNATURE_SERVICE_URL=http://127.0.0.1:8000
# auto | dark | blue
SIGNATURE_EXTRACT_MODE=auto
STAMP_EXTRACT_MODE=auto
# Ask /analyze for per-image parameters before calling /extract.
SIGNATURE_USE_ANALYZE=true
SIGNATURE_SERVICE_TIMEOUT_MS=30000

# remove.bg — optional second engine, offered beside the local one in the
# cutout preview so the two can be compared on the same crop.
# Off-premises and metered: each call uploads the photographed mark to a third
# party and spends a credit, so it is never used by the signing pipeline, only
# by the preview button an operator presses. Leave blank to hide it.
REMOVEBG_API_KEY=
REMOVEBG_SIZE=auto

# Which engine cuts marks out — for the preview AND for the signing pipeline.
#   removebg  the hosted API. Default: on real captures it removed desk shadow
#             and neighbouring handwriting that the local engine kept as solid
#             black. Every extraction uploads the mark to a third party and
#             spends a credit.
#   local     the on-premises container. Free, and nothing is uploaded.
# rembg — local, free, unmetered background removal (MIT). Runs on CPU; start
# it with "pnpm rembg:up". birefnet-general resolves thin strokes and faint ink
# far better than isnet-general-use, which is what a signature is made of, at
# the cost of a bigger one-time download. Alpha matting re-estimates the stroke
# boundary as real coverage instead of the near-binary mask segmentation gives —
# a binary mask around a pen stroke is a staircase.
REMBG_SERVICE_URL=http://localhost:7001
REMBG_MODEL=birefnet-general
REMBG_ALPHA_MATTING=true
REMBG_MATTING_FOREGROUND=240
REMBG_MATTING_BACKGROUND=15
REMBG_MATTING_ERODE=12
REMBG_TIMEOUT_MS=120000

#   rembg     local, free, nothing uploaded and nothing counted. The default.
#   local     the simple non-ML container (signature-remove-bg).
#   removebg  the hosted API: metered, and the mark leaves this machine.
EXTRACTION_ENGINE=rembg
# Use the other engine when the chosen one cannot answer at all — no key, no
# credits, service down — so a lapsed subscription degrades signing instead of
# stopping it. "No ink in this frame" is never a fallback: that is a verdict
# about the photograph and it reaches the signer unchanged.
EXTRACTION_FALLBACK=true

# --- Échelle des marques ---------------------------------------------------
# How a mark is scaled into the zone drawn for it.
# MARK_FILL is the fraction of the zone's WIDTH the mark takes. Width leads
# because that is the dimension operators draw deliberately: strict contain-fit
# was height-led and left marks filling as little as 23% of the box, which is
# what "signature trop petite" meant.
# MARK_MAX_OVERFLOW caps how far the mark's height may exceed the zone's, so a
# squarish mark in a flat box reaches a readable size without climbing into the
# printed text. Set it to 1 for the old strict-contain behaviour.
MARK_FILL=1
MARK_MAX_OVERFLOW=1.5

# Vary each handwritten mark slightly per document and per zone, so a folder
# does not carry one identical bitmap stamped repeatedly. Deterministic —
# regenerating a document reproduces it exactly. Purely cosmetic: it changes how
# the marks sit on the page, not what the document is.
SIGNATURE_VARIANTS=true

# How variants are produced.
#   sigma_lognormal  trace the pen trajectory out of the cutout, decompose the
#                    movement with the Kinematic Theory's Sigma-Lognormal model
#                    and perturb the motor parameters — the mark is re-signed
#                    rather than re-filtered. Falls back on its own whenever a
#                    mark cannot be modelled, so it is safe to leave on.
#   filter           the plain affine + drift + pen-weight path.
SIGNATURE_VARIANT_ENGINE=sigma_lognormal
# How far apart the variants are. 1 = the spread of one person signing twice in
# a row (small on purpose: the marks must still read as the same hand). Towards
# 2 = the same person on different days. Past that they stop looking alike.
SIGNATURE_VARIATION_STRENGTH=1

# --- Limits ---------------------------------------------------------------
MAX_PDF_BYTES=26214400
MAX_IMAGE_BYTES=20971520

# --- Retention ------------------------------------------------------------
# Delete the raw signature photo once the folder is processed successfully.
RETENTION_DELETE_PHOTO_AFTER_SUCCESS=true
# Keep the transparent cutouts (useful for re-generating a PDF). false = delete.
RETENTION_KEEP_CUTOUTS=true
# Hard cutoff: purge any leftover photo older than this many days.
RETENTION_PHOTO_MAX_AGE_DAYS=7

# --- End-to-end smoke test (tools/smoke.mjs) ------------------------------
SMOKE_EMAIL=
SMOKE_PASSWORD=

# ---------------------------------------------------------------------------
# Client-side variables (public by design — no secrets below this line)
# ---------------------------------------------------------------------------

# apps/admin (Vite). The console signs in through the backend, so it needs no
# Supabase key of its own.
VITE_API_URL=http://localhost:8787

# apps/signer reads the same VITE_API_URL. It also falls back to the hostname
# the page was served from when this says localhost but the page is not on
# localhost — a signer's phone would otherwise call itself.
