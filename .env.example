# ---------------------------------------------------------------------------
# Scan&Sign — copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co  (local: http://127.0.0.1:54321)
SUPABASE_URL=http://127.0.0.1:54321
# Public anon key. Safe to ship to the admin web app. NOT used by the mobile app.
SUPABASE_ANON_KEY=replace-me
# Service role key. BACKEND ONLY. Never put this in apps/admin or apps/mobile.
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Storage bucket that holds originals/, processed/, signatures/, stamps/, photos/
SUPABASE_STORAGE_BUCKET=scansign

# --- Backend API ----------------------------------------------------------
API_PORT=8787
API_HOST=0.0.0.0
# Public base URL of this API, used in push notification deep links.
API_PUBLIC_URL=http://localhost:8787
# Comma-separated allowed browser origins for the admin console.
CORS_ORIGINS=http://localhost:5173
# Account creation. The SAME account is used on the web console and on the
# iPhone app — signing in on both is what links a phone to a workspace.
# AUTO_CONFIRM_SIGNUP creates accounts already confirmed (no email round-trip).
AUTO_CONFIRM_SIGNUP=true
# Flip to false once your accounts exist, to close public account creation.
ALLOW_SELF_SIGNUP=true

# --- Signature extraction microservice (fchaussin/signature-remove-bg) -----
# Use 127.0.0.1 rather than localhost: on macOS "localhost" resolves to ::1
# first, and the engine binds IPv4 only, which looks like an outage.
SIGNATURE_SERVICE_URL=http://127.0.0.1:8000
# auto | dark | blue
SIGNATURE_EXTRACT_MODE=auto
STAMP_EXTRACT_MODE=auto
# Ask /analyze for per-image parameters before calling /extract.
SIGNATURE_USE_ANALYZE=true
SIGNATURE_SERVICE_TIMEOUT_MS=30000

# --- Limits ---------------------------------------------------------------
MAX_PDF_BYTES=26214400
MAX_IMAGE_BYTES=20971520

# --- Retention ------------------------------------------------------------
# Delete the raw signature photo once the folder is processed successfully.
RETENTION_DELETE_PHOTO_AFTER_SUCCESS=true
# Keep the transparent cutouts (useful for re-generating a PDF). false = delete.
RETENTION_KEEP_CUTOUTS=true
# Hard cutoff: purge any leftover photo older than this many days.
RETENTION_PHOTO_MAX_AGE_DAYS=7

# --- End-to-end smoke test (tools/smoke.mjs) ------------------------------
SMOKE_EMAIL=
SMOKE_PASSWORD=

# --- Push notifications ---------------------------------------------------
# Optional. Only needed for Expo push receipts on a paid/authenticated project.
EXPO_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Client-side variables (public by design — no secrets below this line)
# ---------------------------------------------------------------------------

# apps/admin (Vite). The console signs in through the backend, so it needs no
# Supabase key of its own.
VITE_API_URL=http://localhost:8787

# apps/mobile (Expo) — the mobile app talks ONLY to the backend API.
# On a physical iPhone this must be your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:8787
